@page
@model Tritean_Elisa_Irina_lab2.Pages.BorrowingPages.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Borrowing</h4>
    <hr />
    <dl class="row">
        <!-- Afișare Membru (Nume și Prenume în loc de ID) -->
        <dt class="col-sm-2">
            Membru
        </dt>
        <dd class="col-sm-10">
            @Model.Borrowing.Member.FirstName @Model.Borrowing.Member.LastName
        </dd>

        <!-- Afișare Carte (Titlul în loc de ID) -->
        <dt class="col-sm-2">
            Carte
        </dt>
        <dd class="col-sm-10">
            @Model.Borrowing.Book.Title
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Borrowing.ReturnDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Borrowing.ReturnDate)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Borrowing.ID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>