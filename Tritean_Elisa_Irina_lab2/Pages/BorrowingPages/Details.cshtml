@page
@model Tritean_Elisa_Irina_lab2.Pages.BorrowingPages.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Borrowing</h4>
    <hr />
    <dl class="row">
        <!-- Afișare Membru (Nume și Prenume în loc de ID) -->
        <dt class="col-sm-2">
            Membru
        </dt>
        <dd class="col-sm-10">
            @Model.Borrowing.Member.FirstName @Model.Borrowing.Member.LastName
        </dd>

        <!-- Afișare Carte (Titlul în loc de ID) -->
        <dt class="col-sm-2">
            Carte
        </dt>
        <dd class="col-sm-10">
            @Model.Borrowing.Book.Title
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Borrowing.ReturnDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Borrowing.ReturnDate)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Borrowing.ID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>